# Provider: zhipu | openai | anthropic
# DEFAULT_PROVIDER is optional — the provider is auto-detected from whichever
# *_API_KEY below is set (detection order: zhipu, openai, anthropic).
# DEFAULT_PROVIDER=zhipu
# DEFAULT_MODEL is optional — falls back to a per-provider default when unset.
# Recommended ids: zhipu glm-5.1 / glm-4.7 · openai gpt-5.1 · anthropic claude-sonnet-4-5
# DEFAULT_MODEL=

# Zhipu AI
ZHIPU_API_KEY=
# ZHIPU_BASE_URL=   # coding 套餐: https://open.bigmodel.cn/api/coding/paas/v4

# OpenAI
# OPENAI_API_KEY=
# OPENAI_BASE_URL=

# Anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=

# Web Search (set one to enable web_search tool)
# Tavily: search + content extraction (recommended)
# TAVILY_API_KEY=
# Serper: Google search snippets only (use fetch_url for full content)
# SERPER_API_KEY=

# For text embedding
# DASHSCOPE_API_KEY=

# Feishu bot channel (/channel start feishu) — 长连接模式，无需公网
# 控制台配置见 docs/feishu-channel.md（订阅方式=长连接、im.message.receive_v1、权限、发布版本）
# KDA_FEISHU_APP_ID=
# KDA_FEISHU_APP_SECRET=
# 可选：仅服务指定会话（chat_id，逗号分隔）；不设置则绑定启动后第一个来消息的会话
# KDA_FEISHU_CHAT_ID=
